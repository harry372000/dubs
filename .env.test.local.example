# Copy this file to .env.test.local and fill in your values.
# NEVER commit .env.test.local to git.

# ── Playwright E2E auth ──────────────────────────────────────────────────────
# A dedicated Clerk test account for automated testing.
# Create one at https://dashboard.clerk.com → Users → Add user
E2E_TEST_EMAIL=your-test-account@example.com
E2E_TEST_PASSWORD=your-test-password

# ── Watch page tests ─────────────────────────────────────────────────────────
# The UUID of a pre-seeded job in your Supabase instance.
# Must belong to the E2E test user and have a known status (e.g. "dubbing").
# Without this, watch page tests are skipped.
E2E_WATCH_JOB_ID=

# ── Optional: override the base URL ─────────────────────────────────────────
# Defaults to http://localhost:3000 if not set.
# PLAYWRIGHT_BASE_URL=https://your-preview.vercel.app
